@model UnidadResidencial.Web.DTOs.ResidencialRoleDTO

@{
    ViewData["Title"] = "Editar Rol";
}

<div class="pagetitle">
    <h1>Dashboard</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-controller="Home" asp-action="Dashboard">Dashboard</a>
            </li>
            <li class="breadcrumb-item">
                <a asp-action="Index">Roles</a>
            </li>
            <li class="breadcrumb-item active">Editar Rol</li>
        </ol>
    </nav>
</div>

<section class="section dashboard">
    <div class="card">
        <div class="card-body">
            <h3 class="card-title">Editar Rol</h3>

            <form class="row g-3" asp-action="Edit" method="POST" id="frmEdit">

                <input type="hidden" asp-for="Id" />

                @await Html.PartialAsync("_Role", Model)

            </form>
        </div>
    </div>

    @await Html.PartialAsync("_Permissions", Model)

    <div class="text-center">
        <button type="submit" class="btn btn-primary" form="frmEdit">Guardar cambios</button>
        <a asp-action="Index" class="btn btn-secondary">Volver</a>
    </div>
</section>


